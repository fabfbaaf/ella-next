# 仅供开发环境；不要把真实密钥提交到 Git。
ELLA_RUNTIME_HOST=127.0.0.1
ELLA_RUNTIME_PORT=8766

# 主聊天：Ollama、本地 Hugging Face、OpenAI/Gemini/DeepSeek 的 Chat Completions 兼容接口。
# 官方 OpenAI 地址为 https://api.openai.com/v1。
# 通用 GEMINI_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY 仅用于对应官方服务。
# 自定义代理须显式设置各路由 ELLA_*_API_KEY，不会继承其他服务的密钥。
ELLA_CHAT_PROVIDER=ollama
ELLA_CHAT_BASE_URL=http://127.0.0.1:11434/v1
ELLA_CHAT_MODEL=
# ELLA_CHAT_API_KEY=

# 操作模型可不设置，此时使用主聊天模型。
# ELLA_ACTION_PROVIDER=deepseek
# ELLA_ACTION_BASE_URL=https://api.deepseek.com
# ELLA_ACTION_MODEL=deepseek-flash
# ELLA_ACTION_API_KEY=

# 语音识别和合成：兼容 OpenAI Audio API 的服务，可只配置识别以使用文字回复。
# ELLA_VOICE_PROVIDER=openai
# ELLA_VOICE_BASE_URL=https://api.openai.com/v1
# ELLA_VOICE_API_KEY=
# ELLA_STT_MODEL=
# ELLA_TTS_MODEL=
# ELLA_TTS_VOICE=

# 可选 Fish Audio 云端 TTS；与上面的语音识别服务分开配置。
# ELLA_TTS_PROVIDER=fish
# ELLA_FISH_API_KEY=
# ELLA_FISH_REFERENCE_ID=
# ELLA_FISH_TTS_MODEL=s2.1-pro-free

# 可选语义向量服务；需提供 OpenAI 兼容 /embeddings 接口。
# 不配置时继续使用 SQLite FTS5 与字串检索。
# ELLA_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# ELLA_EMBEDDING_MODEL=
# ELLA_EMBEDDING_API_KEY=

# Agent 文本文件工作区，默认位于本机 EllaNext/workspace。
# ELLA_AGENT_WORKSPACE=C:\path\to\ella-workspace
# 可选：单独指定编程工作区。源码运行时默认指向当前 ella-next Git 项目。
# ELLA_CODE_WORKSPACE=C:\path\to\your-project

# 浏览器操作默认启动本机 Microsoft Edge；也可使用 chrome。
# ELLA_BROWSER_CHANNEL=msedge

# 已打开的 Word / Excel 窗口编辑需要在 Windows 安装 runtime[office-live]。
# 后台启动 Office 使用系统注册的 App Paths。

# 游戏启动程序和本机插件桥接地址。启动程序必须是绝对 .exe 路径。
# 星露谷会优先查找本机 Steam 库中的 SMAPI；骑砍可自动使用项目内 GABS 和配置。
# ELLA_GAME_MINECRAFT_EXECUTABLE=C:\path\to\MinecraftLauncher.exe
# ELLA_GAME_MINECRAFT_BRIDGE_URL=http://127.0.0.1:9911
# ELLA_GAME_MINECRAFT_BRIDGE_TOKEN=
# ELLA_GAME_STARDEW_VALLEY_EXECUTABLE=C:\path\to\Stardew Valley.exe
# ELLA_GAME_STARDEW_VALLEY_BRIDGE_URL=http://127.0.0.1:9912
# ELLA_GAME_STARDEW_VALLEY_BRIDGE_TOKEN=
# ELLA_GAME_BANNERLORD_EXECUTABLE=C:\path\to\Bannerlord.exe
# 骑砍高影响许可仅支持 GABS 受控桥接，使用 ELLA_GABS_HTTP 或本机 gabs.exe。
# ELLA_GAME_BANNERLORD_BRIDGE_TOKEN=
# 骑砍 GABS：可连接已有本机 MCP 服务，或指定本机 gabs 可执行文件。
# ELLA_GABS_HTTP=http://127.0.0.1:9900/mcp
# ELLA_GABS_EXE=C:\path\to\gabs.exe
# ELLA_GABS_API_KEY=

# 提醒与安静时段所用时区，默认 Asia/Shanghai。
# ELLA_TIMEZONE=Asia/Shanghai

# 可单独配置视觉模型，用于指定前台游戏窗口的截图陪聊。
# ELLA_VISION_PROVIDER=gemini
# ELLA_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ELLA_VISION_MODEL=
# ELLA_VISION_API_KEY=

# 可选 Gemini 人格润色层；普通聊天、整句语音和游戏陪聊使用，操作计划不改写；流式语音只用统一人格提示。
# ELLA_PERSONA_PROVIDER=gemini
# ELLA_PERSONA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ELLA_PERSONA_MODEL=
# ELLA_PERSONA_API_KEY=

# 可选：覆盖人格文件和本地数据目录。
# ELLA_PERSONA_FILE=C:\path\to\persona.md
# ELLA_DATA_DIR=C:\path\to\ella-data

# 游戏插件随安装包提供，启动及每 60 秒自动检测兼容游戏并接入。
# 隔离测试/仅观察检测结果时可以关闭自动写入；手动“重新检测与接入”仍会部署。
# ELLA_GAME_SETUP_AUTO=1
