{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "艾拉 Next",
  "version": "1.0.0",
  "identifier": "ai.ella.next",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "艾拉 Next",
        "width": 220,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "admin",
        "title": "艾拉 Next 管理后台",
        "url": "index.html?window=admin",
        "width": 1220,
        "height": 820,
        "minWidth": 850,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "桔梗",
    "copyright": "Copyright (c) 2026 桔梗",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
